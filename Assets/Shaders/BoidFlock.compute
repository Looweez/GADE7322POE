#pragma kernel CSMain

struct Boid
{
    float3 position;
    float3 velocity;
};

// Buffers
RWStructuredBuffer<Boid> boidsBuffer;

// Parameters passed from C# script
uint numBoids;
float deltaTime;
float3 towerPosition;

// Boid Tuning Parameters
float maxSpeed;
float maxForce;
float neighborRadius;
float separationRadius;

// Orbit Parameters
float orbitRadius;
float orbitForce;
float pullToTowerForce;

[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoids) return;

    Boid boid = boidsBuffer[id.x];

    float3 separation = float3(0, 0, 0);
    float3 alignment = float3(0, 0, 0);
    float3 cohesion = float3(0, 0, 0);

    int neighborCount = 0;
    int separationCount = 0;

    // 1. Calculate Standard Flocking Behaviors
    for (uint i = 0; i < numBoids; i++)
    {
        if (i == id.x) continue;

        float3 offset = boid.position - boidsBuffer[i].position;
        float dist = length(offset);

        if (dist < neighborRadius && dist > 0.0001)
        {
            alignment += boidsBuffer[i].velocity;
            cohesion += boidsBuffer[i].position;
            neighborCount++;

            if (dist < separationRadius)
            {
                separation += (offset / dist); 
                separationCount++;
            }
        }
    }

    float3 accel = float3(0, 0, 0);

    if (separationCount > 0)
    {
        separation /= (float)separationCount;
        accel += clamp(separation * maxSpeed - boid.velocity, -maxForce, maxForce) * 1.5;
    }
    if (neighborCount > 0)
    {
        alignment = (alignment / (float)neighborCount);
        accel += clamp(alignment * maxSpeed - boid.velocity, -maxForce, maxForce);

        cohesion = (cohesion / (float)neighborCount) - boid.position;
        accel += clamp(cohesion * maxSpeed - boid.velocity, -maxForce, maxForce);
    }

    // 2. Calculate Orbiting & Attraction Around Tower
    float3 vecToTower = towerPosition - boid.position;
    vecToTower.y = 0; // Keep horizontal
    float distToTower = length(vecToTower);

    float3 orbitDir = cross(normalize(vecToTower), float3(0, 1, 0)); 
    accel += orbitDir * orbitForce;

    float radiusError = distToTower - orbitRadius;
    accel += normalize(vecToTower) * (radiusError * pullToTowerForce);
    
    // 3. Integrate Velocity & Position
    boid.velocity += accel * deltaTime;

    float speed = length(boid.velocity);
    if (speed > maxSpeed)
    {
        boid.velocity = (boid.velocity / speed) * maxSpeed;
    }

    boid.position += boid.velocity * deltaTime;

    boidsBuffer[id.x] = boid;
}